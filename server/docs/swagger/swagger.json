{
    "swagger": "2.0",
    "info": {
        "description": "Local, read/write REST API for AxeOs-compatible miners (Bitaxe, NerdAxe) on your LAN.\nNo authentication — internal LAN use only.\n\nEndpoints tagged \"dashboard-api\" run on this binary (default :8080).\nEndpoints tagged \"remote-dashboard-api\" run on the separate remote-dashboard-api binary (default :8081),\na read-only API serving miners pushed to hashboard.live — see the project README.",
        "title": "axeos-dashboard API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/config/discover": {
            "get": {
                "description": "Probes a single IP (?ip=) or sweeps a CIDR range (?cidr=, max /24, defaults to the server's own local /24 subnet when both are omitted). ip takes priority if both are set.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboard-api"
                ],
                "summary": "Discover AxeOS devices on the network",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Probe exactly this one IP instead of scanning a range (e.g. a device on a different VLAN than the server). Takes priority over cidr.",
                        "name": "ip",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Network range to sweep, e.g. '192.168.1.0/24' (max /24 = 254 hosts). Omitted: auto-detects and scans the server's own local /24 subnet. Ignored if ip is set.",
                        "name": "cidr",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Per-host probe timeout, e.g. '500ms' or '2s' (default 1s, capped at 3s). Raise it and retry if a scan/probe found nothing on a slow network.",
                        "name": "timeout",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.bitaxesResponse"
                        }
                    },
                    "400": {
                        "description": "invalid/too-large cidr, or invalid/too-large timeout",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "no AxeOS device found at the given ip",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/config/miners": {
            "get": {
                "description": "Returns every miner entry in the managed miners config, including disabled ones. Read-only -- see POST/DELETE for writing.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboard-api"
                ],
                "summary": "List configured miners",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.bitaxesResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Upserts one or more miner entries into the managed miners file, matched by MAC. New entries are always saved enabled.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboard-api"
                ],
                "summary": "Add or update configured miners",
                "parameters": [
                    {
                        "description": "Miner entries to add/update",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.bitaxesResponse"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "the full, updated list of configured miners",
                        "schema": {
                            "$ref": "#/definitions/handler.bitaxesResponse"
                        }
                    },
                    "400": {
                        "description": "invalid request body or entry",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "server not started with -miners -- nowhere safe to write",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "failed to write the miners file",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/config/settings": {
            "get": {
                "description": "Returns the settings.yml overrides, the built-in defaults for pool dashboards/firmware repos, and a read-only snapshot of process-launch settings (poll intervals, firmware cache TTL) shown for visibility only.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboard-api"
                ],
                "summary": "Get app settings",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.appSettingsResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Validates and persists the editable subset of app settings to settings.yml.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboard-api"
                ],
                "summary": "Save app settings",
                "parameters": [
                    {
                        "description": "Settings to save",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/config.AppSettingsFile"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.appSettingsResponse"
                        }
                    },
                    "400": {
                        "description": "invalid settings",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "server has no resolvable config path -- nowhere safe to write",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "failed to write the app-settings file",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/info": {
            "get": {
                "description": "Returns this binary's git SHA, whether it's up to date with the latest GitHub release, the UI feature flags (see config.UIConfig), and (remote-dashboard-api only) the hashboard base URL.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboard-api",
                    "remote-dashboard-api"
                ],
                "summary": "Server build/version info",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.InfoResponse"
                        }
                    }
                }
            }
        },
        "/api/miners": {
            "get": {
                "description": "Returns every enabled miner with its latest snapshot (hashrate, temp, shares, pool, uptime...).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboard-api"
                ],
                "summary": "List all configured miners",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.MinersResponse"
                        }
                    }
                }
            }
        },
        "/api/miners/alerts": {
            "get": {
                "description": "Returns each miner's N most recent alert-bearing entries (today's history only).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboard-api"
                ],
                "summary": "List the most recent miner alerts",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "max entries to return per miner (default 10)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handler.AlertEntry"
                            }
                        }
                    }
                }
            }
        },
        "/api/miners/alerts/history": {
            "get": {
                "description": "Returns every alert episode (consecutive same-type occurrences collapsed into one) on the given day across all miners, most recently active first, optionally filtered by ip/type.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboard-api"
                ],
                "summary": "List a single day's recorded miner alerts, grouped into episodes and paginated",
                "parameters": [
                    {
                        "type": "string",
                        "description": "the single day to scan (YYYY-MM-DD)",
                        "name": "date",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "page number, 1-based (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "episodes per page (default 50, max 200)",
                        "name": "pageSize",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "filter to this miner IP only",
                        "name": "ip",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "filter to this alert type only",
                        "name": "type",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.AlertHistoryResponse"
                        }
                    }
                }
            }
        },
        "/api/miners/pool/fallback/enable": {
            "put": {
                "description": "Switches miner(s) to the primary or fallback pool and restarts them to apply it.",
                "tags": [
                    "dashboard-api"
                ],
                "summary": "Switch stratum pool",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Miner IP or hostname — omit to apply to all configured miners",
                        "name": "miner",
                        "in": "query"
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "502": {
                        "description": "one or more miners didn't apply the change (unreachable, or rejected the request)",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/miners/pool/primary/enable": {
            "put": {
                "description": "Switches miner(s) to the primary or fallback pool and restarts them to apply it.",
                "tags": [
                    "dashboard-api"
                ],
                "summary": "Switch stratum pool",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Miner IP or hostname — omit to apply to all configured miners",
                        "name": "miner",
                        "in": "query"
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "502": {
                        "description": "one or more miners didn't apply the change (unreachable, or rejected the request)",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/miners/{hostnameOrIp}/restart": {
            "post": {
                "description": "Restarts the device via its AxeOs restart endpoint.",
                "tags": [
                    "dashboard-api"
                ],
                "summary": "Restart a miner",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Miner IP or configured hostname",
                        "name": "hostnameOrIp",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "miner not found",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "the miner is unreachable or rejected the restart request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/miners/{hostnameOrIp}/stats": {
            "get": {
                "description": "Returns today's JSONL entries (one per poll cycle) for a single miner, used by the \"Today's History\" chart.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboard-api"
                ],
                "summary": "Get today's stats for one miner",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Miner IP or configured hostname",
                        "name": "hostnameOrIp",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.StatsResponse"
                        }
                    },
                    "404": {
                        "description": "miner not found",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/{boardId}/config/miners": {
            "get": {
                "description": "Returns the managed miners list last pushed to hashboard for this board.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "remote-dashboard-api"
                ],
                "summary": "List a remote board's configured miners (read-only)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "hashboard board ID",
                        "name": "boardId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.bitaxesResponse"
                        }
                    },
                    "404": {
                        "description": "no miners config ever pushed for this board",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/{boardId}/config/settings": {
            "get": {
                "description": "Returns the app settings last pushed to hashboard for this board, with remote push credentials always redacted.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "remote-dashboard-api"
                ],
                "summary": "Get a remote board's app settings (read-only)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "hashboard board ID",
                        "name": "boardId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.appSettingsResponse"
                        }
                    },
                    "404": {
                        "description": "no settings ever pushed for this board",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/{boardId}/miners": {
            "get": {
                "description": "Auto-discovers miners from the board's bitaxes directory — no local config needed, data comes from whatever the feeder already pushed to hashboard.live.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "remote-dashboard-api"
                ],
                "summary": "List miners pushed to a hashboard board (read-only)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "hashboard board ID",
                        "name": "boardId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.MinersResponse"
                        }
                    },
                    "404": {
                        "description": "board not found",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/{boardId}/miners/alerts": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "remote-dashboard-api"
                ],
                "summary": "List the most recent miner alerts for a hashboard board (read-only)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "hashboard board ID",
                        "name": "boardId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "max entries to return per miner (default 10)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handler.AlertEntry"
                            }
                        }
                    }
                }
            }
        },
        "/api/{boardId}/miners/alerts/history": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "remote-dashboard-api"
                ],
                "summary": "List a single day's recorded miner alerts for a hashboard board, grouped into episodes and paginated (read-only)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "hashboard board ID",
                        "name": "boardId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "the single day to scan (YYYY-MM-DD)",
                        "name": "date",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "page number, 1-based (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "episodes per page (default 50, max 200)",
                        "name": "pageSize",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "filter to this miner IP only",
                        "name": "ip",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "filter to this alert type only",
                        "name": "type",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.AlertHistoryResponse"
                        }
                    }
                }
            }
        },
        "/api/{boardId}/{ip}/stats": {
            "get": {
                "description": "Returns today's JSONL entries pushed to hashboard.live for a single miner in the board.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "remote-dashboard-api"
                ],
                "summary": "Get today's stats for one remote miner (read-only)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "hashboard board ID",
                        "name": "boardId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Miner IP",
                        "name": "ip",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.StatsResponse"
                        }
                    },
                    "500": {
                        "description": "data file missing or unreadable",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "config.AppSettingsFile": {
            "type": "object",
            "properties": {
                "electricity": {
                    "$ref": "#/definitions/config.ElectricityConfig"
                },
                "firmware": {
                    "$ref": "#/definitions/config.AppSettingsFirmware"
                },
                "pools": {
                    "$ref": "#/definitions/config.PoolsConfig"
                },
                "remote": {
                    "$ref": "#/definitions/config.RemoteConfig"
                }
            }
        },
        "config.AppSettingsFirmware": {
            "type": "object",
            "properties": {
                "repos": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            }
        },
        "config.Bitaxe": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "fallbackPort": {
                    "type": "integer"
                },
                "fallbackUrl": {
                    "type": "string"
                },
                "fallbackUser": {
                    "type": "string"
                },
                "hostname": {
                    "type": "string"
                },
                "ip": {
                    "type": "string"
                },
                "mac": {
                    "description": "Mac is the device's MAC address (colons/hyphens optional, normalized\nby StorageKey) -- the storage-directory key, stable across IP/\nlocation changes unlike Ip. Populated either by hand or by the network\ndiscovery flow (see internal/discovery), which reads it straight off\nthe device's own /api/system/info response.",
                    "type": "string"
                },
                "model": {
                    "$ref": "#/definitions/config.Model"
                },
                "port": {
                    "type": "integer"
                },
                "schedule": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/config.CronSchedule"
                    }
                },
                "url": {
                    "type": "string"
                },
                "user": {
                    "type": "string"
                }
            }
        },
        "config.CronSchedule": {
            "type": "object",
            "properties": {
                "action": {
                    "$ref": "#/definitions/config.ScheduleAction"
                },
                "cron": {
                    "type": "string"
                }
            }
        },
        "config.ElectricityConfig": {
            "type": "object",
            "properties": {
                "ratePerKwh": {
                    "description": "RatePerKwh is the electricity cost in euros per kilowatt-hour (e.g. 0.1915 for 19.15 cts/kWh).",
                    "type": "number"
                }
            }
        },
        "config.Model": {
            "type": "string",
            "enum": [
                "bitaxe",
                "nerdaxe"
            ],
            "x-enum-varnames": [
                "ModelBitaxe",
                "ModelNerdaxe"
            ]
        },
        "config.PoolsConfig": {
            "type": "object",
            "properties": {
                "dashboards": {
                    "description": "Dashboards maps a stratum pool hostname to its web dashboard URL\ntemplate. Use {user} as placeholder — replaced by the account part\nof the stratum user (before the first dot). Example:\n\"stratum.braiins.com\" -\u003e \"https://pool.braiins.com/mining/overview/{user}\"",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            }
        },
        "config.RemoteConfig": {
            "type": "object",
            "properties": {
                "apiKey": {
                    "type": "string"
                },
                "pushURL": {
                    "type": "string"
                }
            }
        },
        "config.ScheduleAction": {
            "type": "string",
            "enum": [
                "switch_primary",
                "switch_fallback",
                "restart"
            ],
            "x-enum-varnames": [
                "ActionSwitchPrimary",
                "ActionSwitchFallback",
                "ActionRestart"
            ]
        },
        "handler.AlertEntry": {
            "type": "object",
            "properties": {
                "alerts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Alert"
                    }
                },
                "hostname": {
                    "type": "string"
                },
                "minerIp": {
                    "type": "string"
                },
                "minerMac": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "handler.AlertEpisode": {
            "type": "object",
            "properties": {
                "firstSeen": {
                    "type": "string"
                },
                "hostname": {
                    "type": "string"
                },
                "lastSeen": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "minerIp": {
                    "type": "string"
                },
                "minerMac": {
                    "type": "string"
                },
                "occurrences": {
                    "type": "integer"
                },
                "peakValue": {
                    "type": "number"
                },
                "threshold": {
                    "type": "number"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "handler.AlertHistoryResponse": {
            "type": "object",
            "properties": {
                "episodes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handler.AlertEpisode"
                    }
                },
                "page": {
                    "type": "integer"
                },
                "pageSize": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "handler.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
